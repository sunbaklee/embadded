APP_NAME=IoT LoneCare
APP_ENV=production
HOST_PORT=8000
DATABASE_URL=sqlite:////app/data/lonecare.db

# 위험(danger) 판단 기준 — 실제 운영: 43200(12시간), 발표 시연: 60(60초)
INACTIVITY_THRESHOLD_SECONDS=43200
# 주의(warning) 판단 기준 — 기본 21600(6시간)
WARNING_THRESHOLD_SECONDS=21600
PRESSURE_DELTA_THRESHOLD=100
SENSOR_OFFLINE_SECONDS=30
# 압력 유지 + 움직임 없음 경고 사용 여부
PRESSURE_NO_MOTION_ENABLED=true
# 배터리 부족 경고 기준(%)
LOW_BATTERY_THRESHOLD=20
# Wi-Fi 약신호 경고 기준(dBm)
WEAK_WIFI_THRESHOLD=-75
LOG_LIMIT_MAX=500

# 선택 사항: development에서는 기본 true, production에서는 기본 false
# SIMULATION_ENABLED=false
